# =============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (AI Studio & Vercel Production)
# =============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Destination email address for new membership verification requests.
ADMIN_EMAIL="YOUR_ADMIN_EMAIL_HERE"

# ADMIN_SECRET_KEY: Required for securing /api/membership/lookup and preventing unauthorized access.
ADMIN_SECRET_KEY="YOUR_SECURE_ADMIN_SECRET_KEY"

# =============================================================================
# PRODUCTION PERSISTENT STORAGE (Vercel Production)
# =============================================================================
# 1. DATABASE_URL / POSTGRES_URL:
#    Connection string for PostgreSQL / Neon / Supabase / Vercel Postgres.
#    Used for permanently storing membership applicant records, UTRs, and statuses.
#    Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# 2. BLOB_READ_WRITE_TOKEN:
#    Read/write token for Vercel Blob (or S3/Cloud storage).
#    Used for permanently and privately storing payment screenshots.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# 3. RESEND_API_KEY (Optional):
#    API key for sending immediate automated emails to the admin when a new submission arrives.
RESEND_API_KEY="re_..."
